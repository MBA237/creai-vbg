APP_NAME=CREAI-VBG
APP_TIMEZONE=Africa/Douala
APP_URI=

# Base de données.
# En local (XAMPP) : localhost / root / (vide).
# Sur Hostinger : DATABASE_SERVER doit être exactement « localhost » (surtout pas l'adresse
# « srvXXXX.hstgr.io », ni l'IP, ni le nom du domaine : cela bloque le site environ 1 minute),
# avec le nom, l'utilisateur et le mot de passe créés dans hPanel > Bases de données.
DATABASE_SERVER=localhost
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=creai_vbg

# Mettre à 1 UNIQUEMENT pour diagnostiquer : affiche la cause exacte d'une erreur de connexion.
# À remettre à 0 (ou supprimer) une fois le problème résolu.
APP_DEBUG=0

# Assistant en ligne (facultatif)
AI_API_URL=https://api.anthropic.com/v1/messages
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
